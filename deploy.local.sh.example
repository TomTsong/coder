# ════════════════════════════════════════════════════════════════
#  本地部署配置模板
#  用法：
#    cp deploy.local.sh.example deploy.local.sh
#    然后编辑 deploy.local.sh，填入真实服务器信息。
#  deploy.local.sh 已被 .gitignore 忽略，不会提交到公开仓库。
# ════════════════════════════════════════════════════════════════

# 服务器公网 IP（真实值，勿提交到公开仓库）
SERVER_IP="1.2.3.4"

# 服务器登录用户名
SERVER_USER="ubuntu"

# SSH 端口（默认 22）
SSH_PORT="22"
